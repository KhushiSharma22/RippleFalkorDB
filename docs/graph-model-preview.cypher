// Toy instance of docs/graph-model.md v1 for visual inspection in FalkorDB Browser.
// Loaded into the throwaway graph "model_preview" by backend/scripts/load_model_preview.py.
// NOT the product seed: seed.py builds the real graph from scenario YAML.
CREATE
  (dock:Location {id:'dock', name:'Dock', x:0.0, y:0.0}),
  (pbay:Location {id:'primary_bay', name:'Primary bay', x:2.0, y:2.0}),
  (sbay:Location {id:'standby_bay', name:'Standby bay', x:2.0, y:-2.0}),
  (hroom:Location {id:'header_room', name:'Header room', x:4.0, y:0.0}),
  (hall:Location {id:'machine_hall', name:'Machine hall', x:6.0, y:0.0}),
  (dock)-[:ADJACENT_TO {cost:10}]->(pbay),
  (dock)-[:ADJACENT_TO {cost:10}]->(sbay),
  (pbay)-[:ADJACENT_TO {cost:8}]->(hroom),
  (sbay)-[:ADJACENT_TO {cost:8}]->(hroom),
  (hroom)-[:ADJACENT_TO {cost:6}]->(hall),

  (ps:Asset:Supply {id:'primary_supply', name:'Primary supply', nominal_capacity:8}),
  (ss:Asset:Supply {id:'standby_supply', name:'Standby supply', nominal_capacity:8}),
  (miv:Asset:Valve {id:'main_isolation', name:'Main isolation valve', normally:'open'}),
  (bv:Asset:Valve {id:'bypass', name:'Bypass valve', normally:'closed'}),
  (h:Asset:Header {id:'cooling_header', name:'Cooling header'}),
  (ma:Asset:Machine {id:'machine_a', name:'Machine A', demand:4, criticality:'critical'}),
  (mb:Asset:Machine {id:'machine_b', name:'Machine B', demand:3, criticality:'low'}),
  (sa:Service {id:'line_a', name:'Line A production', critical:true}),
  (sb:Service {id:'line_b', name:'Line B production', critical:false}),

  (ps)-[:FEEDS]->(miv), (miv)-[:FEEDS]->(h),
  (ss)-[:FEEDS]->(bv), (bv)-[:FEEDS]->(h),
  (h)-[:FEEDS]->(ma), (h)-[:FEEDS]->(mb),
  (ps)-[:CONNECTED_TO]->(miv), (miv)-[:CONNECTED_TO]->(h),
  (ss)-[:CONNECTED_TO]->(bv), (bv)-[:CONNECTED_TO]->(h),
  (h)-[:CONNECTED_TO]->(ma), (h)-[:CONNECTED_TO]->(mb),
  (ma)-[:PROVIDES_SERVICE]->(sa), (mb)-[:PROVIDES_SERVICE]->(sb),
  (ps)-[:LOCATED_IN]->(pbay), (miv)-[:LOCATED_IN]->(pbay),
  (ss)-[:LOCATED_IN]->(sbay), (bv)-[:LOCATED_IN]->(sbay),
  (h)-[:LOCATED_IN]->(hroom), (ma)-[:LOCATED_IN]->(hall), (mb)-[:LOCATED_IN]->(hall),

  (ip1:InspectionPoint {id:'ip_standby_pump', name:'Standby pump gauge'}),
  (ip2:InspectionPoint {id:'ip_bypass_valve', name:'Bypass valve indicator'}),
  (ip3:InspectionPoint {id:'ip_header_flow', name:'Header flow meter'}),
  (ip1)-[:INSPECTS {property:'capacity'}]->(ss), (ip1)-[:INSPECTS {property:'health'}]->(ss),
  (ip2)-[:INSPECTS {property:'position'}]->(bv),
  (ip3)-[:INSPECTS {property:'flow'}]->(h),
  (ip1)-[:LOCATED_IN]->(sbay), (ip2)-[:LOCATED_IN]->(sbay), (ip3)-[:LOCATED_IN]->(hroom),

  (temp:Sensor {id:'temp_a', kind:'temperature'}),
  (temp)-[:MEASURES {property:'temperature'}]->(ma), (temp)-[:LOCATED_IN]->(hall),
  (robot:Robot {id:'robot_1', name:'Inspector'}),
  (robot)-[:AT {since:0.0}]->(dock),

  (inc:Incident {id:'inc_1', opened_at:100.0, status:'open'}),
  (o1:Observation {id:'obs_1', property:'temperature', value:41.0, unit:'C', observed_at:100.0, ingested_at:100.2, quality:0.9, source:'sensor'}),
  (o1)-[:ABOUT]->(ma), (o1)-[:PRODUCED_BY]->(temp), (o1)-[:DURING]->(inc),
  (o2:Observation {id:'obs_2', property:'capacity', value:8, unit:'units', observed_at:-86400.0, ingested_at:-86400.0, quality:0.6, source:'log'}),
  (o2)-[:ABOUT]->(ss),
  (hyp:Hypothesis {id:'hyp_primary_failure', name:'Primary supply failure', status:'open'}),
  (inc)-[:HAS_HYPOTHESIS]->(hyp),
  (hyp)-[:EXPECTS {property:'flow', op:'<', value:4}]->(h),
  (hyp)-[:DISTINGUISHED_BY]->(ip3),
  (o1)-[:SUPPORTS {rule:'temp_rising'}]->(hyp),

  (act:Action {id:'isolate_primary', name:'Isolate primary supply', kind:'valve'}),
  (c1:Condition {id:'c_standby_active', property:'health', op:'=', value:'ok', kind:'evidence'}),
  (c2:Condition {id:'c_bypass_open', property:'position', op:'=', value:'open', kind:'evidence'}),
  (c3:Condition {id:'c_capacity', kind:'computed', check:'demand_within_capacity'}),
  (act)-[:REQUIRES]->(c1), (c1)-[:CONDITION_ON]->(ss),
  (act)-[:REQUIRES]->(c2), (c2)-[:CONDITION_ON]->(bv),
  (act)-[:REQUIRES]->(c3), (c3)-[:CONDITION_ON]->(h),
  (act)-[:AFFECTS {property:'position', value:'closed'}]->(miv)
